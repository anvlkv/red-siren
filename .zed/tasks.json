[
  {
    "label": "Xcode — list devices",
    "command": "xcrun xctrace list devices",
    "reveal": "always"
  },
  {
    "label": "Start Tauri [dev server]",
    "command": "cargo tauri dev",
    "env": {
      "RUST_BACKTRACE": "1"
    },
    "reveal": "always",
    "use_new_terminal": true
  }
]
