[
  {
    "label": "pnpm: install",
    "command": "pnpm",
    "args": ["install"],
    "save": "none",
    "reveal": "always",
    "hide": "on_success",
    "show_summary": true,
    "show_command": true
  },

  {
    "label": "frontend: dev (vite)",
    "command": "pnpm",
    "args": ["run", "dev"],
    "save": "all",
    "allow_concurrent_runs": true,
    "use_new_terminal": false,
    "reveal": "always",
    "hide": "never",
    "show_summary": true,
    "show_command": true
  },

  {
    "label": "tauri: dev",
    "command": "cargo",
    "args": ["tauri", "dev"],
    "cwd": "$ZED_WORKTREE_ROOT/src-tauri",
    "save": "all",
    "allow_concurrent_runs": true,
    "use_new_terminal": false,
    "reveal": "always",
    "hide": "never",
    "show_summary": true,
    "show_command": true
  },

  {
    "label": "frontend: preview",
    "command": "pnpm",
    "args": ["run", "preview"],
    "save": "all",
    "reveal": "always",
    "hide": "on_success",
    "show_summary": true,
    "show_command": true
  },

  {
    "label": "frontend: build",
    "command": "pnpm",
    "args": ["run", "build"],
    "save": "all",
    "reveal": "always",
    "hide": "on_success",
    "show_summary": true,
    "show_command": true
  },

  {
    "label": "tauri: build",
    "command": "cargo",
    "args": ["tauri", "build"],
    "cwd": "$ZED_WORKTREE_ROOT/src-tauri",
    "save": "all",
    "reveal": "always",
    "hide": "on_success",
    "show_summary": true,
    "show_command": true
  },

  {
    "label": "cargo: build (debug)",
    "command": "cargo",
    "args": ["build"],
    "cwd": "$ZED_WORKTREE_ROOT/src-tauri",
    "save": "all",
    "reveal": "always",
    "hide": "on_success",
    "show_summary": true,
    "show_command": true
  },

  {
    "label": "cargo: build --release",
    "command": "cargo",
    "args": ["build", "--release"],
    "cwd": "$ZED_WORKTREE_ROOT/src-tauri",
    "save": "all",
    "reveal": "always",
    "hide": "on_success",
    "show_summary": true,
    "show_command": true
  },

  {
    "label": "cargo: test",
    "command": "cargo",
    "args": ["test"],
    "cwd": "$ZED_WORKTREE_ROOT/src-tauri",
    "save": "all",
    "reveal": "always",
    "hide": "on_success",
    "show_summary": true,
    "show_command": true
  },

  {
    "label": "tauri: info",
    "command": "cargo",
    "args": ["tauri", "info"],
    "cwd": "$ZED_WORKTREE_ROOT/src-tauri",
    "save": "none",
    "reveal": "always",
    "hide": "on_success",
    "show_summary": true,
    "show_command": true
  }
]
